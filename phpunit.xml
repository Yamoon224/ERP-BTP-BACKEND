<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>

        <!--
            Les tests tournent sur MySQL, comme la production. Une suite verte
            sur SQLite ne prouverait rien des contraintes réellement appliquées
            en production : types de colonnes, longueurs d'index, comportement
            des clés étrangères et des colonnes JSON diffèrent d'un moteur à
            l'autre. La base de test est distincte de la base applicative et
            réinitialisée à chaque exécution.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="erp_btp_test"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>

        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>

        <!-- Réglages du moteur figés pour que les tests ne dépendent pas du .env local. -->
        <env name="MATCHING_ENGINE_VERSION" value="1.0.0"/>
        <env name="MATCHING_PRICE_TOLERANCE_RATIO" value="0.01"/>
        <env name="MATCHING_PRICE_TOLERANCE_ABSOLUTE" value="0.5"/>
        <env name="MATCHING_QUANTITY_TOLERANCE_RATIO" value="0"/>
        <env name="MATCHING_QUANTITY_TOLERANCE_ABSOLUTE" value="0"/>
        <env name="MATCHING_DEFAULT_CURRENCY" value="EUR"/>
        <env name="MATCHING_BASE_CURRENCY" value="EUR"/>

        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
