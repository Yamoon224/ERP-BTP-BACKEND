APP_NAME="ERP BTP - Rapprochement 3 voies"
APP_ENV=local
# Genere par `php artisan key:generate` — ne jamais committer de vraie cle.
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Paris
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de donnees ---------------------------------------------------------
# MySQL 8. La base doit exister avant la premiere migration :
#   CREATE DATABASE erp_btp CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp_btp
DB_USERNAME=root
DB_PASSWORD=

# Base dediee aux tests : elle est videe a chaque execution de la suite, ne
# jamais y pointer la base applicative.
DB_TEST_DATABASE=erp_btp_test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="erp@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend / CORS ---------------------------------------------------------
# Origines autorisees a appeler l API (application Next.js). Separer par des
# virgules pour en declarer plusieurs.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Moteur de rapprochement -------------------------------------------------
# Version tracee dans chaque decision archivee. A incrementer quand les regles
# de rapprochement changent, pour qu une decision passee reste explicable.
MATCHING_ENGINE_VERSION=1.0.0

# Ecart de prix unitaire tolere : le plus permissif des deux seuils.
# Relatif (0.01 = 1 %) pour les articles a forte valeur, absolu pour eviter
# qu un article a faible prix parte en revue pour un centime d arrondi.
MATCHING_PRICE_TOLERANCE_RATIO=0.01
# Exprime en devise de reference (XOF) : 0.5 avait un sens en euro, aucun ici.
MATCHING_PRICE_TOLERANCE_ABSOLUTE=250

# Sur-facturation en quantite toleree. Zero par defaut : facturer plus que
# commande n est jamais un arrondi. A remonter pour les matieres en vrac
# (sable, beton) si le contrat fournisseur le prevoit.
MATCHING_QUANTITY_TOLERANCE_RATIO=0
MATCHING_QUANTITY_TOLERANCE_ABSOLUTE=0

# --- Devises -----------------------------------------------------------------
# Devises supportees : EUR, USD, XOF. Une facture peut etre libellee dans une
# autre devise que son bon de commande : le rapprochement convertit alors au
# taux en vigueur a la date de la facture.
#
# Devise proposee par defaut aux documents crees sans devise explicite.
MATCHING_DEFAULT_CURRENCY=XOF

# Devise d'agregation du tableau de bord, et devise dans laquelle la tolerance
# absolue ci-dessus est exprimee avant conversion.
MATCHING_BASE_CURRENCY=XOF
